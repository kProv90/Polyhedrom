rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Handle management
    match /data/auth/handles/{handle} {
      allow read: if true;  // Anyone can check if a handle exists
      
      allow create: if 
        isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        !exists(/databases/$(database)/documents/data/auth/handles/$(handle));
      
      allow delete: if isOwner(resource.data.uid);
      allow update: if false;  // Handles cannot be updated, only created or deleted
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;  // Basic profile info is public
      allow create: if isOwner(userId);  // Can only create their own profile
      allow update: if isOwner(userId);  // Can only update their own profile
      allow delete: if isOwner(userId);  // Can only delete their own profile
    }

    // Catch-all rule - deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}